[Unit]
Description=P1 MD5SUM cross-check service and web console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/Group to the account that owns /usr/local/trinop (usually trinop).
User=trinop
Group=trinop
WorkingDirectory=/usr/local/trinop/site_scripts/md5check_live
ExecStart=/usr/local/trinop/site_scripts/md5check_live/run_md5check.sh run
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
# Resource caps. Hashing is I/O bound, and the first pass over a full job
# reads every P1 file once (~13 s per 7 GB on the staging VM); after that the
# mtime+size cache means a tick costs milliseconds. Nice + idle I/O keep the
# cold pass from ever competing with Trinav for the disk.
MemoryMax=256M
CPUQuota=100%
Nice=10
IOSchedulingClass=idle

# Optional hang detection (enable AFTER the first verified run):
# change Type=simple to Type=notify and uncomment:
# WatchdogSec=120

[Install]
WantedBy=multi-user.target
